# --- Environment files (never commit real values; keep .env.example) ---
.env
.env.*
!.env.example

# --- Logs ---
*.log
logs/

# --- OS / editor ---
.DS_Store
Thumbs.db

# --- Local file storage / uploads (customers/manage-customer-attachments) ---
App_Data/

# --- Secrets / credentials — should never exist in the repo at all ---
*.pfx
*.pem
*.key
secrets/
credentials/

# --- Local tooling state (personal machine/session config, not project source) ---
.claude/settings.local.json
