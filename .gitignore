# --- .NET (src/BackEnd also has its own, more specific .gitignore) ---
bin/
obj/
*.user
*.suo
.vs/
.idea/
appsettings.*.local.json

# --- Node / frontend (src/FrontEnd also has its own, more specific .gitignore) ---
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
