<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CustomerSupportCRM.Domain\CustomerSupportCRM.Domain.csproj" />
    <ProjectReference Include="..\CustomerSupportCRM.Application\CustomerSupportCRM.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Infrastructure is a plain class library (no hosting model, no Kestrel) but
      needs the ASP.NET Core Identity types (Microsoft.AspNetCore.Identity.dll,
      Microsoft.AspNetCore.Identity.AddIdentity<TUser,TRole>) that ship in the
      shared framework rather than as a standalone NuGet package. This grants
      access to those assemblies without making Infrastructure a Web project.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!-- 4.16.0 is the smallest version that resolves both known advisories on
         4.9.0: MailKit's own STARTTLS response-injection issue (GHSA-9j88-vvj5-vhgr,
         fixed at 4.16.0) and MimeKit's CRLF-injection issue (GHSA-g7hc-96xr-gvvx,
         fixed at 4.15.1, pulled in transitively). -->
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
