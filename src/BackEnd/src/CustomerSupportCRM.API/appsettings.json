{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Initial Catalog=CustomerSupportDB;Integrated Security=True;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "Jwt": {
    "Issuer": "CustomerSupportCRM",
    "Audience": "CustomerSupportCRM.Client",
    "SecretKey": "",
    "ExpirationMinutes": 60,
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
    "RefreshTokenExpirationDays": 14
  },
  "Localization": {
    "DefaultCulture": "en",
    "SupportedCultures": [ "en", "ar" ]
  },
  "ApplicationSettings": {
    "ApplicationName": "Customer Support CRM"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "PasswordReset": {
    "ResetUrlBase": "http://localhost:5173/reset-password",
    "TokenLifetimeMinutes": 60
  },
  "AdminSeed": {
    "Email": "",
    "Password": ""
  },
  "Email": {
    "FromAddress": "",
    "FromDisplayName": "Support",
    "ReplyToDomain": "",
    "Smtp": { "Host": "", "Port": 587, "User": "", "Password": "", "UseStartTls": true },
    "Inbound": { "WebhookSecret": "" }
  },
  "FileStorage": {
    "LocalRootPath": "App_Data/attachments",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".txt", ".csv", ".doc", ".docx", ".xls", ".xlsx" ]
  }
}
