# Copy this file to .env.local (gitignored) and adjust per environment.
# Everything prefixed with VITE_ is bundled into the browser build - never put
# a secret (JWT signing key, database password, backend credentials, ...) here.
# The frontend only ever needs public, non-sensitive configuration.

# Base URL of the CustomerSupportCRM.API backend, including its "/api" prefix.
# Matches src/BackEnd/src/CustomerSupportCRM.API/Properties/launchSettings.json
# (the "https" profile) for local development against the existing backend.
VITE_API_BASE_URL=https://localhost:7125
